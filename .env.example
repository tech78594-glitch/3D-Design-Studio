# VITE_HF_TOKEN: Hugging Face access token, used to call the Inference API.
# Vite only exposes env vars prefixed with VITE_ to client-side code
# (see https://vite.dev/guide/env-and-mode.html#env-files).
#
# IMPORTANT: this app is a static site with no backend. Any value here
# ends up readable in the deployed bundle/network requests by anyone who
# opens the site. Use a token scoped to "Inference" only (never a token
# with write/repo access), and treat it as public. For anything higher
# stakes, put the Hugging Face call behind a small serverless proxy
# (e.g. a Cloudflare Worker) instead of calling the API directly from
# the browser.
VITE_HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# VITE_HF_MODEL: Hugging Face model id to call, e.g. "meta-llama/Llama-3.1-8B-Instruct".
VITE_HF_MODEL="MY_MODEL_ID"
